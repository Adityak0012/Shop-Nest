# Copy this file to ".env" and fill in your values.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200

# MongoDB. Leave empty to use a temporary in-memory database (data resets on restart).
# Local MongoDB:  mongodb://127.0.0.1:27017/shopnest
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopnest
MONGO_URI=

# Use a long random string in real deployments
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Razorpay TEST mode keys (Dashboard > Account & Settings > API Keys, with Test Mode on).
# Leave empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin account created by the seed
ADMIN_EMAIL=admin@shopnest.dev
ADMIN_PASSWORD=Admin@123

# Hugging Face token for "npm run images" (generates product photos).
# Create one at https://huggingface.co/settings/tokens  (Fine-grained -> "Make calls to Inference Providers")
HF_TOKEN=
# Optional: another text-to-image model
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
